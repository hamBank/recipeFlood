# /etc/recipeflood-pull-backup.conf   (on the BACKUP server; root:rfpull, mode 0640)
# Shell KEY=VALUE, read by recipeflood-pull-backup.sh. Only SRC_HOST is required.

# The app server and the restricted user scripts/add_backup_reader.sh created there.
SRC_HOST=rfbackup@camelidcastle.hups.club

# Where the copies go is set in the unit (Environment=DEST=/lklBackup/sites_apps/recipeFlood),
# next to the ReadWritePaths= and RequiresMountsFor= that let the sandboxed service write
# there. Don't set DEST here: a path the unit doesn't open is read-only to it.

# Our history. The app server keeps 7 days; we keep longer, but never fewer than
# MIN_KEEP of each kind (so a broken source can't make us prune everything).
#KEEP_DAYS=90
#MIN_KEEP=7

# Fail if the newest dump or uploads tarball is older than this: the app server's
# backup job has stopped.
#MAX_AGE_HOURS=30

#SSH_KEY=/var/lib/recipeflood-backup/.ssh/id_ed25519
#KNOWN_HOSTS=/var/lib/recipeflood-backup/.ssh/known_hosts
