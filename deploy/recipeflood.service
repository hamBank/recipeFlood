[Unit]
Description=Recipe Flood (uvicorn)
After=network.target postgresql.service

[Service]
User=recipeFlood
Group=recipeFlood
WorkingDirectory=/opt/recipeFlood
EnvironmentFile=/opt/recipeFlood/.env
ExecStart=/opt/recipeFlood/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8002
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
