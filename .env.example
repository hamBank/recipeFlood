# Recipe Flood production configuration — copy to .env and fill in.
# Loaded by the systemd unit (EnvironmentFile) and by deploy.sh for alembic.

DATABASE_URL=postgresql+psycopg2://recipeFlood@/recipeflood?host=/var/run/postgresql
AUTH_ENABLED=true

# true  = anyone can browse recipes; sign-in is only needed to add/edit and
#         to see ingredient costs (the default — see SPEC.md "Visibility")
# false = the whole site is behind the allowlist
PUBLIC_READ=true

# Google OAuth (see DEPLOYMENT.md for setup instructions)
GOOGLE_CLIENT_ID=

# Long random strings — e.g. `openssl rand -hex 32`
JWT_SECRET=
DEPLOY_SECRET=

# Comma-separated bootstrap allowlist. The FIRST of these to sign in
# becomes the admin; invite everyone else from the app afterwards.
ALLOWED_EMAILS=

# Display only.
CURRENCY_SYMBOL=$

# Temporary cleanup switch for the Pantry page: select several rows at
# once and merge them all into one, instead of the normal one-pair-at-a-
# time flow. Off by default — turn on for a tidy-up pass (e.g. after
# scripts/find_duplicate_ingredients.py turns up a backlog), back off
# once the pantry's settled.
PANTRY_MULTI_MERGE=false

# Volume->weight conversion convention for new recipes.
#   au = 250ml cup, 20ml tablespoon  (correct for the imported blog)
#   us = 240ml cup, 15ml tablespoon
UNITS_SYSTEM=au

# Where recipe photos are written. Back this up — it is not in git.
UPLOAD_DIR=/opt/recipeFlood/uploads

# Anthropic API key for AI import (paste / photo) and for
# scripts/parse_blog.py. Unset = those features report "not configured"
# and everything else works normally.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI API key for scripts/generate_recipe_images.py (placeholder photos
# for recipes with none). A separate provider/key from Anthropic — Claude
# doesn't generate images. Unset = the script reports "not configured"
# rather than running; nothing else needs this key.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
